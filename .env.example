# Environment Configuration Template for Student Feedback Assistant
# Copy this file to .env and adjust variables as needed

# Project & Security
PROJECT_NAME="Student Feedback Assistant"
SECRET_KEY="cie_project_super_secret_jwt_key_2026_change_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Default: SQLite local database)
DATABASE_URL="sqlite:///./backend/data/student_assistant.db"

# Default Seed Administrator Credentials
ADMIN_EMAIL="admin@institution.edu"
ADMIN_PASSWORD="Admin@123"
ADMIN_NAME="Dean of Academic Affairs"

# AI Provider Settings (Optional: Leave empty for 100% offline local RAG fallback)
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="all-MiniLM-L6-v2"
